<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>webOS-1 — My Content Prototype</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="bg" id="bg"></div>

  <main class="ui">
    <div class="my-content-card" aria-live="polite">
      <h2 class="section-title">My Content</h2>
      <div class="carousel" id="carousel" tabindex="0" role="listbox" aria-label="My content carousel">
        <!-- Cards inserted by markup for simplicity -->
        <div class="tile" role="option" aria-selected="true" data-title="Featured App" data-sub="Continue watching">
          <div class="thumb" style="background-color:#3B82F6"></div>
        </div>
        <div class="tile" role="option" data-title="Photos" data-sub="Recent">
          <div class="thumb" style="background:linear-gradient(45deg,#ef4444,#f97316)"></div>
        </div>
        <div class="tile" role="option" data-title="Movies" data-sub="New releases">
          <div class="thumb" style="background:linear-gradient(45deg,#10b981,#06b6d4)"></div>
        </div>
        <div class="tile" role="option" data-title="Games" data-sub="Top picks">
          <div class="thumb" style="background:linear-gradient(45deg,#a78bfa,#f472b6)"></div>
        </div>
        <div class="tile" role="option" data-title="Settings" data-sub="Preferences">
          <div class="thumb" style="background:linear-gradient(45deg,#facc15,#fb7185)"></div>
        </div>
      </div>

      <div class="focus-info" id="focusInfo" aria-hidden="false">
        <div class="info-thumb" id="infoThumb"></div>
        <div class="info-text">
          <div class="info-title" id="infoTitle">Featured App</div>
          <div class="info-sub" id="infoSub">Continue watching</div>
        </div>
      </div>
    </div>
  </main>

  <script src="script.js"></script>
</body>
</html>:root{
  --bg-blur: 12px;
  --card-height: 140px;
  --tile-width: 220px;
  --gap: 18px;
  --accent: rgba(255,255,255,0.12);
  --glass: rgba(255,255,255,0.06);
}
*{box-sizing:border-box}
html,body{height:100%;margin:0;font-family:Inter,system-ui,Segoe UI,Roboto,"Helvetica Neue",Arial;color:#fff}
.bg{
  position:fixed;inset:0;
  background-image:url(''); /* Replace with your image path or set via JS */
  background-size:cover;background-position:center;
  filter:blur(var(--bg-blur)) brightness(.7);
  transform:scale(1.03);
  z-index:0;
}
.ui{position:relative;z-index:5;min-height:100%;display:flex;align-items:flex-end;justify-content:center;padding:48px}
.my-content-card{
  width:92%;max-width:1400px;
  margin-bottom:36px;
  backdrop-filter: blur(6px);
  border-radius:12px;
  padding:18px 22px;
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.2));
  box-shadow: 0 10px 30px rgba(0,0,0,0.6);
  display:flex;flex-direction:column;gap:14px;align-items:center;
}
.section-title{font-size:18px;margin:0 0 6px 6px;align-self:flex-start;opacity:.95}
.carousel{
  width:100%;
  display:flex;gap:var(--gap);
  padding:10px 6px;
  align-items:end;
  overflow:hidden;
  position:relative;
}
.tile{
  width:var(--tile-width);
  height:var(--card-height);
  border-radius:10px;
  flex:0 0 auto;
  transform-origin:center bottom;
  transition: transform .25s cubic-bezier(.2,.9,.3,1), box-shadow .25s;
  position:relative;
  outline: none;
  cursor: pointer;
}
.thumb{
  position:absolute;inset:0;border-radius:10px;
  box-shadow: inset 0 -20px 40px rgba(0,0,0,0.35);
}
.tile:not(.active){filter:grayscale(.05) contrast(.9);opacity:.9}
.tile.active{
  transform:translateY(-18px) scale(1.12);
  box-shadow: 0 22px 36px rgba(0,0,0,0.6), 0 6px 18px rgba(0,0,0,0.5);
  z-index:10;
}
.focus-info{
  width:100%;max-width:1000px;
  margin-top:-18px;
  display:flex;align-items:center;gap:14px;
  background: linear-gradient(90deg, rgba(255,255,255,0.02), rgba(0,0,0,0.25));
  padding:12px;border-radius:10px;
  backdrop-filter: blur(6px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.45);
}
.info-thumb{width:96px;height:64px;border-radius:6px;background:#222;flex:0 0 auto;box-shadow:inset 0 -6px 14px rgba(0,0,0,0.6)}
.info-text{display:flex;flex-direction:column}
.info-title{font-weight:700;font-size:16px}
.info-sub{font-size:13px;opacity:.8;margin-top:4px}

/* Responsive / TV-large adjustments */
@media (max-width:900px){
  :root{--tile-width:160px;--card-height:110px}
}<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>webOS-1 — TV Settings Prototype</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="bg" id="bg"></div>

  <main class="ui">
    <section class="settings-rail" aria-label="Settings">
      <aside class="rail">
        <div class="rail-inner">
          <div class="rail-icon" aria-hidden="true">
            <!-- settings gear icon -->
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 15.5A3.5 3.5 0 1 0 12 8.5a3.5 3.5 0 0 0 0 7z"></path>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06A2 2 0 1 1 2.3 16.9l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 7.6a1.65 1.65 0 0 0-.33-1.82L4.2 5.7A2 2 0 1 1 7 2.87l.06.06a1.65 1.65 0 0 0 1.82.33h.09A1.65 1.65 0 0 0 10.4 2.6V2a2 2 0 0 1 4 0v.09c.2.07.4.18.57.31.43.34.97.44 1.48.28.1-.03.2-.06.3-.09l.06-.02A2 2 0 1 1 19.4 6.1l-.06.02c-.1.03-.2.06-.3.09-.5.16-1.05.06-1.48-.28a1.65 1.65 0 0 0-.57-.31V7.6a1.65 1.65 0 0 0 1 .82c.6.26 1.14.8 1.4 1.4.16.5.04 1.05-.28 1.48-.06.07-.12.14-.19.21z"></path>
            </svg>
          </div>

          <div class="rail-label">Settings</div>
        </div>
      </aside>

      <div class="content-area">
        <div class="settings-grid">
          <nav class="categories" id="categories" aria-label="Settings categories" tabindex="0">
            <!-- category items inserted here -->
            <button class="cat active" data-key="picture">Picture</button>
            <button class="cat" data-key="sound">Sound</button>
            <button class="cat" data-key="network">Network</button>
            <button class="cat" data-key="inputs">Inputs</button>
            <button class="cat" data-key="system">System</button>
          </nav>

          <section class="details" id="details" aria-live="polite">
            <!-- details pane -->
            <h2 id="detailTitle">Picture</h2>

            <div id="detailContent">
              <!-- Picture controls -->
              <div class="control-row">
                <label>Picture Mode</label>
                <select class="control" data-path="picture.mode">
                  <option>Standard</option>
                  <option>Vivid</option>
                  <option>Movie</option>
                  <option>Game</option>
                </select>
              </div>

              <div class="control-row">
                <label>Brightness</label>
                <input type="range" class="control" min="0" max="100" value="70" data-path="picture.brightness" />
                <div class="control-value" data-path-display="picture.brightness">70</div>
              </div>

              <div class="control-row">
                <label>Contrast</label>
                <input type="range" class="control" min="0" max="100" value="60" data-path="picture.contrast" />
                <div class="control-value" data-path-display="picture.contrast">60</div>
              </div>

              <div class="control-row toggle-row">
                <label>Auto Power Saving</label>
                <button class="toggle control" data-path="picture.powerSave" aria-pressed="false">Off</button>
              </div>
            </div>
          </section>
        </div>
      </div>
    </section>
  </main>

  <script src="script.js"></script>
</body>
</html>// Keyboard + click focus handling for the rail + carousel
(function(){
  const carousel = document.getElementById('carousel');
  const tiles = Array.from(carousel.querySelectorAll('.tile'));
  const infoThumb = document.getElementById('infoThumb');
  const infoTitle = document.getElementById('infoTitle');
  const infoSub = document.getElementById('infoSub');
  const bg = document.getElementById('bg');

  // Optionally set the background image:
  // bg.style.backgroundImage = "url('assets/your-photo.jpg')";

  let idx = 0;
  function updateActive(newIdx){
    idx = Math.max(0, Math.min(tiles.length-1, newIdx));
    tiles.forEach((t,i)=>{
      t.classList.toggle('active', i===idx);
      t.setAttribute('aria-selected', i===idx ? 'true' : 'false');
    });
    const active = tiles[idx];
    // Update info panel
    infoTitle.textContent = active.dataset.title || '';
    infoSub.textContent = active.dataset.sub || '';
    const thumb = active.querySelector('.thumb');
    infoThumb.style.background = getComputedStyle(thumb).background;
    // center the active tile in carousel view
    centerTileInView(active);
  }

  function centerTileInView(tile){
    const container = carousel;
    const containerRect = container.getBoundingClientRect();
    const tileRect = tile.getBoundingClientRect();
    const offset = (tileRect.left + tileRect.width/2) - (containerRect.left + containerRect.width/2);
    container.scrollBy({left: offset, behavior:'smooth'});
  }

  // Set up events
  tiles.forEach((t,i)=>{
    t.addEventListener('click', ()=> updateActive(i));
    t.addEventListener('focus', ()=> updateActive(i));
    t.setAttribute('tabindex','0');
  });

  carousel.addEventListener('keydown', (e)=>{
    if(e.key === 'ArrowRight'){ e.preventDefault(); updateActive(idx+1); }
    if(e.key === 'ArrowLeft'){ e.preventDefault(); updateActive(idx-1); }
    if(e.key === 'Enter'){ e.preventDefault(); /* perform activation */ alert('Activate: '+tiles[idx].dataset.title); }
  });

  // allow global arrow keys to control when focus is on body
  window.addEventListener('keydown', (e)=>{
    const rootFocus = (document.activeElement === document.body || document.activeElement === carousel);
    if(!rootFocus) return;
    if(e.key === 'ArrowRight'){ e.preventDefault(); carousel.focus(); updateActive(idx+1); }
    if(e.key === 'ArrowLeft'){ e.preventDefault(); carousel.focus(); updateActive(idx-1); }
  });

  updateActive(0);
})();[Unit]
Description=Kiosk UI Launcher
After=graphical.target network.target
Wants=graphical.target

[Service]
User=root
Environment=DISPLAY=:0
ExecStart=/usr/local/bin/start-kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target[core]
idle-time=0

[shell]
locking=falsefunction handleKeyEvent(key) {
  if (key === 'ArrowLeft') focusLeft();
  else if (key === 'ArrowRight') focusRight();
  else if (key === 'Enter') activateFocused();
  else if (key === 'Back') goBack();
}

window.addEventListener('keydown', (e) => handleKeyEvent(e.key));

let pointerTimer;
document.addEventListener('pointermove', (e) => {
  // convert to element-under-pointer focus
  const el = document.elementFromPoint(e.clientX, e.clientY);
  setFocusToElement(el);
});
document.addEventListener('pointerdown', (e) => {
  const el = document.elementFromPoint(e.clientX, e.clientY);
  activateElement(el);
});#!/usr/bin/env python3
# cec-to-uinput.py
# Run as root. Listens to cec-client stdout and maps CEC codes to Linux key events via uinput.

import subprocess
import re
import sys
from evdev import UInput, ecodes as e

# Configure mapping: CEC hex code (string) -> evdev key
# You should run 'cec-client' in monitor mode to see which codes your TV sends and adjust mapping.
CEC_TO_KEY = {
    # Example mappings (common codes; verify on your TV):
    "0x41": e.KEY_UP,
    "0x42": e.KEY_DOWN,
    "0x43": e.KEY_LEFT,
    "0x44": e.KEY_RIGHT,
    "0x09": e.KEY_ENTER,    # often 'select' or 'ok' - change if different
    "0x0A": e.KEY_BACK,     # often 'back' / return
    "0x44": e.KEY_PLAY,     # play (if needed)
    # Add other codes you observe...
}

# Start cec-client in monitor mode (-m)
proc = subprocess.Popen(['cec-client', '-m', '--monitor'] , stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

ui = UInput()  # default capabilities are fine for simple key events

# pattern examples in cec-client output:
# DEBUG:   >> key pressed: 0x41
# DEBUG:   >> key released:
pattern = re.compile(r'key (pressed|released):\s*(0x[0-9a-fA-F]+)?')

print("CEC->uinput bridge starting... (press Ctrl-C to stop)", file=sys.stderr)
try:
    for line in proc.stdout:
        line = line.strip()
        m = pattern.search(line)
        if not m:
            continue
        action = m.group(1)
        code = m.group(2)
        if not code:
            continue
        # lookup mapping
        key = CEC_TO_KEY.get(code)
        if not key:
            # optionally log unrecognized codes
            print("Unmapped CEC code:", code, file=sys.stderr)
            continue
        if action == 'pressed':
            ui.write(e.EV_KEY, key, 1)
            ui.syn()
        elif action == 'released':
            ui.write(e.EV_KEY, key, 0)
            ui.syn()
except KeyboardInterrupt:
    print("Shutting down")
finally:
    proc.terminate()
    ui.close()[Unit]
Description=CEC to uinput bridge
After=multi-user.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/cec-to-uinput.py
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target// Keyboard (arrows + enter + back)
window.addEventListener('keydown', (e) => {
  // remote sends ArrowUp/ArrowDown/ArrowLeft/ArrowRight/Enter/Backspace/Exit depending on model
  switch (e.key) {
    case 'ArrowUp':     focusUp(); break;
    case 'ArrowDown':   focusDown(); break;
    case 'ArrowLeft':   focusLeft(); break;
    case 'ArrowRight':  focusRight(); break;
    case 'Enter':       activateFocused(); break;
    case 'Backspace':
    case 'Escape':
    case 'Back':        goBack(); break;
  }
});

// Pointer (air mouse) - update hover/focus with pointer coords
document.addEventListener('pointermove', (e) => {
  // e.clientX,e.clientY are available; map to your UI coordinate system
  updatePointer(e.clientX, e.clientY);
});
document.addEventListener('pointerdown', (e) => {
  // left click from remote -> activate element under pointer
  handlePointerClick(e.clientX, e.clientY);
});
panel-position=none

[launcher]
icon=/usr/share/pixmaps/chromium.png

[output]
name=HDMI-A-1
mode=1920x1080@60
